{
  "name": "remi-companion",
  "displayName": "小蕾米 · 悬浮桌宠",
  "description": "原始小蕾米动画、鼠标视线跟随、拖动与任务状态，悬浮在编辑器上方。macOS 原生浮窗。",
  "version": "0.3.0",
  "publisher": "local-remi",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "scripts": {
    "build": "bash scripts/build-native.sh",
    "test": "node --test test/*.test.js && bash scripts/test-native.sh",
    "package": "npm run build && vsce package --allow-missing-repository --skip-license --target darwin-arm64 --out remi-companion.vsix",
    "test:host": "bash scripts/test-host.sh",
    "test:account": "node scripts/test-account.js",
    "test:attachments": "node scripts/test-attachments-account.js"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "remi.show",
        "title": "小蕾米：显示悬浮宠物"
      },
      {
        "command": "remi.hide",
        "title": "小蕾米：隐藏"
      },
      {
        "command": "remi.toggle",
        "title": "小蕾米：显示 / 隐藏"
      },
      {
        "command": "remi.chat",
        "title": "小蕾米：快捷聊天"
      },
      {
        "command": "remi.activities",
        "title": "小蕾米：任务动态"
      },
      {
        "command": "remi.animations",
        "title": "小蕾米：预览全部动作"
      },
      {
        "command": "remi.resetPosition",
        "title": "小蕾米：重置位置"
      },
      {
        "command": "remi.settings",
        "title": "小蕾米：设置"
      },
      {
        "command": "remi.newChat",
        "title": "小蕾米：新建聊天"
      },
      {
        "command": "remi.chatHistory",
        "title": "小蕾米：账号会话历史"
      }
    ],
    "configuration": {
      "title": "小蕾米",
      "properties": {
        "remi.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启动时显示悬浮宠物。"
        },
        "remi.size": {
          "type": "number",
          "default": 112,
          "minimum": 64,
          "maximum": 240,
          "description": "宠物宽度（像素）。"
        },
        "remi.followCursor": {
          "type": "boolean",
          "default": true,
          "description": "使用原始 16 方向素材跟随鼠标。"
        },
        "remi.alwaysVisible": {
          "type": "boolean",
          "default": false,
          "description": "切换到其他应用时仍显示宠物。默认只在所属编辑器窗口前台显示。"
        },
        "remi.reducedMotion": {
          "type": "boolean",
          "default": false,
          "description": "停用连续动画和视线跟随。"
        },
        "remi.trackTasks": {
          "type": "boolean",
          "default": true,
          "description": "显示本窗口的任务、调试与终端执行状态。"
        },
        "remi.model": {
          "type": "string",
          "default": "",
          "description": "快捷聊天模型 ID；留空时首次聊天让你选择可用模型。"
        },
        "remi.chatBackend": {
          "type": "string",
          "enum": [
            "vscode",
            "codex"
          ],
          "enumDescriptions": [
            "使用编辑器语言模型，仅发送聊天消息。",
            "使用本机已登录的 Codex CLI；可读取工作区并请求工具操作，历史由 CLI 保存。"
          ],
          "default": "vscode",
          "description": "快捷聊天后端。",
          "scope": "window"
        },
        "remi.codexPath": {
          "type": "string",
          "default": "",
          "description": "Codex CLI 可执行文件路径；留空优先使用已安装应用自带版本，其次使用 PATH 中的 codex。不接受命令行参数。",
          "scope": "machine"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Elys1an-Y1san/remi-vscode-pet.git"
  },
  "bugs": {
    "url": "https://github.com/Elys1an-Y1san/remi-vscode-pet/issues"
  }
}
